# ─── Firebase Admin SDK (server-side, keep secret) ──────────────────────────
FIREBASE_PROJECT_ID=mason-market
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@mason-market.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: override default storage bucket name
# FIREBASE_STORAGE_BUCKET=mason-market.firebasestorage.app

# ─── Firebase Client SDK (public, safe for browser) ────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mason-market.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mason-market
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
